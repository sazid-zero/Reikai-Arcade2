# Database URL (Optional: required only if connecting to a PostgreSQL / Neon database)
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Better Auth Secret (Optional: generated 32+ character random string)
# BETTER_AUTH_SECRET="your-secure-random-secret-key-at-least-32-chars"

# Better Auth Base URL (Optional: Vercel automatically sets VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL)
# BETTER_AUTH_URL="https://your-domain.vercel.app"
